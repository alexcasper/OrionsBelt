/* ===========================================================================
 * 3. Convenience: state size in bytes (for the memory-optimization story)
 * ===========================================================================*/

/* Returns the number of bytes saved per GDN layer by narrowing state to fp16.
 * Qwen3.5-4B: 524,288 floats/layer × 4 bytes = 2,097,152 bytes fp32
 *                                × 2 bytes = 1,048,576 bytes fp16
 * Saving: 1,048,576 bytes = 1.0 MiB per layer, 24.0 MiB across 24 layers. */
size_t gdn_state_bytes_saved_fp16(size_t num_floats_per_layer, size_t num_layers) {
    return num_floats_per_layer * num_layers * 2; /* fp32(4) - fp16(2) per element */
}


