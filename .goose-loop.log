#!/usr/bin/env python3
"""Minimal manifest generator for Python 3.6 (no __future__ annotations)."""
import json, os, re, socket, platform, glob, subprocess, sys
from datetime import datetime, timezone

def safe(fn, *args, **kwargs):
    try:
        return fn(*args, **kwargs)
    except Exception:
        return None

def read_text(path):
    try:
        with open(path, 'r') as f:
            return f.read()
    except Exception:
        return None

def read_int_file(path):
    text = safe(read_text, path)
    if text is None:
        return None
    try:
        return int(text.strip())
    except ValueError:
        return None

def run_cmd(cmd):
    try:
        r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=5, check=True)
        return r.stdout.decode('utf-8', errors='replace').strip()
    except Exception:
        return None

def utc_stamp():
    return datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')

def git_sha():
    return safe(run_cmd, ['git', 'rev-parse', 'HEAD'])

def git_dirty():
    status = safe(run_cmd, ['git', 'status', '--porcelain'])
    if status is None:
        return None
    return len(status) > 0

def hostname():
    return safe(socket.gethostname)

def kernel_version():
    return safe(platform.release)

def machine_arch():
    return safe(platform.machine)

def cpu_model():
    text = safe(read_text, '/proc/cpuinfo')
    if text:
        for key in ('model name', 'Hardware', 'Model'):
            match = re.search(r'^' + re.escape(key) + r'\s*:\s*(.+)$', text, re.MULTILINE)
            if match:
                return match.group(1).strip()
    return safe(platform.processor) or None

def core_count():
    return safe(os.cpu_count)

def cpufreq_topology():
    base = '/sys/devices/system/cpu'
    if not os.path.isdir(base):
        return None
    cpu_dirs = sorted(glob.glob(os.path.join(base, 'cpu[0-9]*')),
                      key=lambda p: int(re.search(r'cpu(\d+)$', p).group(1)))
    if not cpu_dirs:
        return None
    topo = []
    for d in cpu_dirs:
        cpu_id = int(re.search(r'cpu(\d+)$', d).group(1))
        entry = {
            'cpu': cpu_id,
            'max_freq_khz': read_int_file(os.path.join(d, 'cpufreq', 'scaling_max_freq')),
            'min_freq_khz': read_int_file(os.path.join(d, 'cpufreq', 'scaling_min_freq')),
            'governor': safe(lambda dd=d: (read_text(os.path.join(dd, 'cpufreq', 'scaling_governor')) or '').strip()),
            'cpu_capacity': read_int_file(os.path.join(d, 'cpu_capacity')),
        }
        topo.append(entry)
    return topo

def isa_features():
    if machine_arch() not in ('aarch64', 'arm64'):
        return None
    text = safe(read_text, '/proc/cpuinfo')
    if not text:
        return None
    match = re.search(r'^Features\s*:\s*(.+)$', text, re.MULTILINE)
    if not match:
        return None
    present = set(match.group(1).split())
    features = ('sve', 'sve2', 'i8mm', 'bf16', 'asimddp', 'sme')
    return {f: (f in present) for f in features}

def thermal_zones():
    if not os.path.isdir('/sys/class/thermal'):
        return None
    zones = sorted(glob.glob('/sys/class/thermal/thermal_zone*'))
    result = []
    for d in zones:
        result.append({
            'zone': os.path.basename(d),
            'type': safe(lambda dd=d: (read_text(os.path.join(dd, 'type')) or '').strip()),
            'temp_millicelsius': read_int_file(os.path.join(d, 'temp')),
        })
    return result

def meminfo():
    text = safe(read_text, '/proc/meminfo')
    if text is None:
        return None
    result = {'mem_total_kb': None, 'mem_available_kb': None}
    for key, field in (('MemTotal', 'mem_total_kb'), ('MemAvailable', 'mem_available_kb')):
        match = re.search(r'^' + key + r':\s*(\d+)\s*kB', text, re.MULTILINE)
        if match:
            result[field] = int(match.group(1))
    return result

def optional_packages():
    versions = {}
    for name in ('torch', 'transformers', 'onnxruntime', 'numpy'):
        try:
            import importlib
            versions[name] = importlib.metadata.version(name)
        except Exception:
            versions[name] = None
    return versions

manifest = {
    'manifest_version': 1,
    'run_id': 'jetson-j1',
    'timestamp_utc': utc_stamp(),
    'git': {'sha': git_sha(), 'dirty': git_dirty()},
    'host': {
        'hostname': hostname(),
        'machine': machine_arch(),
        'kernel': kernel_version(),
        'os': safe(platform.platform),
        'cpu_model': cpu_model(),
        'core_count': core_count(),
        'cpu_topology': cpufreq_topology(),
    },
    'isa_features': isa_features(),
    'thermal_zones': thermal_zones(),
    'memory': meminfo(),
    'software': {
        'python_version': sys.version,
        'python_implementation': safe(platform.python_implementation),
        'packages': optional_packages(),
    },
    'caller': {
        'note': 'Generated by fallback script on Python 3.6.9 (manifest.py requires 3.7+)',
        'benchmark_binary': 'dist/bench_gdn_jetson_a57',
        'dispatch_path': 'neon',
        'governor': 'performance',
    },
}

print(json.dumps(manifest, indent=2, sort_keys=True))
