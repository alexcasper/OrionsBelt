# 4B weights estimate
h = 2560; k_dim = 2048; v_dim = 4096; conv_dim = 8192; conv_k = 4
n_vh = 32; n_kh = 16; n_attn = 16; n_kv = 4; fa_hd = 256; vocab = 248320
gdn_layers = 24; fa_layers = 8; total_layers = 32; intermediate = 12288

gdn_per = h*(k_dim*2+v_dim) + h*v_dim + h*n_vh + h*n_vh + v_dim*h + conv_dim*conv_k + 128
fa_per = h*(n_attn*fa_hd*2) + h*(n_kv*fa_hd) + h*(n_kv*fa_hd) + n_attn*fa_hd*h + fa_hd*2
mlp_per = h*intermediate + h*intermediate + intermediate*h
embed = vocab*h; lm_head = vocab*h

total_params = gdn_per*gdn_layers + fa_per*fa_layers + mlp_per*total_layers + embed + lm_head
weights_fp16 = total_params * 2
print('4B total params: %d (%.2fB)' % (total_params, total_params/1e9))
print('4B weights FP16: %.1f MiB (%.2f GiB)' % (weights_fp16/(1024*1024), weights_fp16/(1024**3)))

# KV cache @ 4K
kv_4k = n_kv * fa_hd * 2 * 4096 * fa_layers * 2
kv_262k = n_kv * fa_hd * 2 * 262144 * fa_layers * 2
print('KV @4K FP16: %.1f MiB' % (kv_4k/(1024*1024)))
print('KV @262K FP16: %.1f MiB (%.2f GiB)' % (kv_262k/(1024*1024), kv_262k/(1024**3)))

# Recurrent state
state = 32 * 128 * 128 * gdn_layers * 4
print('State FP32: %.1f MiB' % (state/(1024*1024)))

# Ratio at 262K
print('KV/State ratio @262K: %.1fx' % (kv_262k/state))
print()
print('All memory calculations verified!')
"


