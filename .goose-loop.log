#include <stdlib.h>
#include <math.h>
#include <stddef.h>
#include <string.h>

/* fp32 reference kernels */
void gdn_gated_scan_f32(const float *, const float *, float *, float *, size_t, size_t);
void gdn_cumdecay_f32(const float *, float *, size_t, size_t);

