import json, os, subprocess, platform, time

def run(cmd):
    try:
        return subprocess.check_output(cmd, shell=True, stderr=subprocess.STDOUT).decode().strip()
    except:
        return "N/A"

def read_file(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except:
        return "N/A"

manifest = {}
manifest["timestamp"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
manifest["hostname"] = run("hostname")
manifest["device_label"] = "jetson-j2"
manifest["uname"] = run("uname -a")
manifest["architecture"] = platform.machine()
manifest["python_version"] = platform.python_version()

# CPU info
cpuinfo = run("grep -m1 Features /proc/cpuinfo")
manifest["cpu_features"] = cpuinfo
manifest["nproc"] = run("nproc")

# CPU freq and governor
govs = []
freqs = []
for i in range(int(manifest.get("nproc","4") or "4")):
    g = read_file("/sys/devices/system/cpu/cpu%d/cpufreq/scaling_governor" % i)
    f = read_file("/sys/devices/system/cpu/cpu%d/cpufreq/cpuinfo_max_freq" % i)
    cf = read_file("/sys/devices/system/cpu/cpu%d/cpufreq/scaling_cur_freq" % i)
    govs.append({"cpu": i, "governor": g, "max_freq_khz": f, "cur_freq_khz": cf})
manifest["cpus"] = govs

# Thermals
thermals = []
for z in sorted(os.listdir("/sys/class/thermal/")):
    if z.startswith("thermal_zone"):
        zone_path = "/sys/class/thermal/" + z
        t = read_file(os.path.join(zone_path, "type"))
        temp = read_file(os.path.join(zone_path, "temp"))
        thermals.append({"zone": z, "type": t, "temp_millic": temp})
manifest["thermals_post"] = thermals

# Memory
manifest["meminfo"] = run("free -m | head -2")

# Git SHA
manifest["git_sha"] = run("git rev-parse HEAD")
manifest["git_branch"] = run("git rev-parse --abbrev-ref HEAD")

# Binary info
manifest["binary"] = "dist/bench_gdn_jetson_a57"
manifest["build_flags"] = "-mcpu=cortex-a57 -static -O3"

# Compiler
manifest["compiler"] = run("aarch64-linux-gnu-gcc --version | head -1")

print(json.dumps(manifest, indent=2))
