sys.path.insert(0, str(_REPO_ROOT))
sys.path.insert(0, str(_BENCH_DIR))

from bench.memory import (  # noqa: E402
    DTYPE_BYTES,
    MemoryBreakdown,
    MemoryModel,
    compute_kv_cache,
    compute_memory,
    compute_recurrent_state,
    compute_weights,
