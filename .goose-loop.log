                "linear_conv_kernel_dim": 4,
                "intermediate_size": 9216,
                "vocab_size": 248320,
                "tie_word_embeddings": True,
            }
        }
        cfg = metrics.ModelConfig.from_hf_config(config)
        assert cfg.hidden_size == 2560
        assert cfg.num_gdn_layers == 24


