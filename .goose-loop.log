void gdn_cumdecay_f16(const float *, _Float16 *, size_t, size_t);
void gdn_gated_scan_bf16(const float *, const float *, float *, __bf16 *, size_t, size_t);
void gdn_cumdecay_bf16(const float *, __bf16 *, size_t, size_t);

