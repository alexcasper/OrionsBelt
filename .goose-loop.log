static inline float _bf16_to_f32(__bf16 v) {
    unsigned short bits;
    memcpy(&bits, &v, sizeof(bits));
    unsigned int u = (unsigned int)bits << 16;
    float f;
    memcpy(&f, &u, sizeof(f));
