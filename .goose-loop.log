import random, hashlib, json, os, tempfile

# Inline test of core corpus logic (Py3.6 compatible)

# Test haystack generation
FILLER_PASSAGES = [
    'The art of war is of vital importance to the State.',
    'It is a truth universally acknowledged.',
    'Call me Ishmael.',
]

def generate_haystack(target_chars, rng):
    chunks = []
    current_len = 0
    idx = rng.randint(0, len(FILLER_PASSAGES) - 1)
    while current_len < target_chars:
        passage = FILLER_PASSAGES[idx % len(FILLER_PASSAGES)]
        chunks.append(passage)
        current_len += len(passage) + 2
        idx += 1
    text = '  '.join(chunks)
    if len(text) > target_chars:
        text = text[:target_chars].rsplit(' ', 1)[0] + '.'
    return text

rng1 = random.Random(42)
rng2 = random.Random(42)
t1 = generate_haystack(500, rng1)
t2 = generate_haystack(500, rng2)
assert t1 == t2, 'Haystack should be deterministic'
assert abs(len(t1) - 500) < 100, 'Haystack length should be ~500'
print('Haystack generation: PASS')

# Test seed derivation
def depth_seed(master, ctx_len, depth):
    key = '{}:{}:{:.2f}:niah'.format(master, ctx_len, depth)
    h = hashlib.md5(key.encode()).hexdigest()
    return int(h[:8], 16)

s1 = depth_seed(42, 4096, 0.0)
s2 = depth_seed(42, 4096, 0.5)
s3 = depth_seed(42, 4096, 1.0)
assert s1 != s2 != s3, 'Seeds should differ by depth'
assert depth_seed(42, 4096, 0.5) == depth_seed(42, 4096, 0.5), 'Seeds should be deterministic'
print('Seed derivation: PASS')

# Test NIAH single generation (simplified)
NIAH_TEMPLATES = [
    ('The magic number is {number}.', 'What is the magic number?', '{number}'),
    ('The password is {number}.', 'What is the password?', '{number}'),
]

def generate_niah(ctx_len, depth, seed):
    rng = random.Random(seed)
    haystack = generate_haystack(1000, rng)
    template_idx = rng.randint(0, len(NIAH_TEMPLATES) - 1)
    needle_stmt, question, answer_fmt = NIAH_TEMPLATES[template_idx]
    number = rng.randint(10000, 99999)
    needle = needle_stmt.format(number=number)
    answer = answer_fmt.format(number=number)
    insert_pos = int(len(haystack) * depth)
    context = haystack[:insert_pos] + needle + ' ' + haystack[insert_pos:]
    prompt = context + '\n\n' + question
    return prompt, answer

p1, a1 = generate_niah(4096, 0.5, 12345)
p2, a2 = generate_niah(4096, 0.5, 12345)
assert p1 == p2, 'NIAH should be deterministic'
assert a1 == a2, 'Answer should be deterministic'
assert a1 in p1, 'Answer should appear in prompt'
assert 'What is' in p1[-200:], 'Question should be at end'
print('NIAH single generation: PASS')

# Test multikey generation (simplified)
def generate_multikey(ctx_len, num_keys, seed):
    rng = random.Random(seed)
    pairs = []
    for i in range(num_keys):
        key = 'key_{:04d}'.format(i)
        value = 'val_{}'.format(rng.randint(100, 999))
        pairs.append((key, value))
    query_idx = rng.randint(num_keys // 4, 3 * num_keys // 4)
    return pairs[query_idx][1], len(pairs)

ans, nkeys = generate_multikey(4096, 10, 99999)
assert nkeys == 10
assert ans.startswith('val_')
print('Multikey generation: PASS')

